          formato: ["reel","carrusel","story"]
        },
        plantilla: (v) => `Humor sobre <span class="hl" data-eje="tema">${v.tema}</span> con ángulo <span class="hl2" data-eje="angulo">${v.angulo}</span> en <span class="hl" data-eje="formato">${v.formato}</span>.`
      }
    }
  },

  tiktok: {
    nombre: "TikTok",
    ejes: {
      gancho: ["'Nadie te dijo esto…'","'Esto va a molestar a alguien'","'POV:'","'3 cosas que…'","'Reacciono a…'"],
      tema: ["libros","noticias","humor","ciencia","productividad","cultura pop"],
      formato: ["hablando a cámara","storytime","reacción","tutorial","sketch","green screen"],
      duracion: ["15s","30s","60s","3 min"]
    },
    plantilla: (v) => `<span class="hl2" data-eje="gancho">${v.gancho}</span> sobre <span class="hl" data-eje="tema">${v.tema}</span> en formato <span class="hl" data-eje="formato">${v.formato}</span> de <span class="hl2" data-eje="duracion">${v.duracion}</span>.`
  }
};

/* =========================================================
   PLANTILLAS DE PROMPT PARA GENERACIÓN DE IMÁGENES
   ========================================================= */
const PROMPT_STYLES = {
  dibujos: {
    construir: (v) => `TASK: CREATE AN IMAGE.
