image/jpeg;base64,"}];

/* =========================================================
   ESTADO
   ========================================================= */
let apartadoActual = "dibujos";
let subActual = null;
let ideaActual = null;
let fijados = {};
let banco = [];
let propuestasPanel = [];

const navEl = document.getElementById("nav");
const subnavEl = document.getElementById("subnav");
const resultado = document.getElementById("resultado");
const metaEl = document.getElementById("meta");
const historialUl = document.getElementById("historial");

const elegir = arr => arr[Math.floor(Math.random() * arr.length)];

/* =========================================================
   CONFIGURACIÓN ACTIVA
   ========================================================= */
function ejesActivos() {
  const ap = APARTADOS[apartadoActual];
  if (ap.subcategorias) {
    return ap.subcategorias[subActual] || Object.values(ap.subcategorias)[0];
  }
  return ap;
}
function plantillaActiva() {
  const ap = APARTADOS[apartadoActual];
  if (ap.subcategorias) {
    const sub = ap.subcategorias[subActual] || Object.values(ap.subcategorias)[0];
    return sub.plantilla;
  }
  return ap.plantilla;
}

/* =========================================================
   NAV
   ========================================================= */
function renderNav() {
  navEl.innerHTML = "";
  const tabs = [["generar","Generar"],["banco","Banco"]];
  tabs.forEach(([key,label]) => {
    const b = document.createElement("button");
    b.textContent = label;
    const activo = (key === "generar" && !document.getElementById("panel-generar").hidden) ||
                   (key === "banco" && !document.getElementById("panel-banco").hidden);
    if (activo) b.classList.add("activo");
    b.onclick = () => mostrarPanel(key);
    navEl.appendChild(b);
  });
}

/* =========================================================
   SELECTOR DE APARTADO
   ========================================================= */
function renderSelectores() {
  subnavEl.innerHTML = "";
  subnavEl.classList.add("visible");

  Object.entries(APARTADOS).forEach(([key, ap]) => {
    const b = document.createElement("button");
    b.textContent = ap.nombre;
    if (key === apartadoActual) b.classList.add("activo");
    b.onclick = () => {
      apartadoActual = key;
      subActual = ap.subcategorias ? Object.keys(ap.subcategorias)[0] : null;
      renderSelectores();
      resultado.textContent = "Pulsa generar…";
      metaEl.innerHTML = "";
      fijados = {};
    };
    subnavEl.appendChild(b);

    if (key === apartadoActual && ap.subcategorias) {
      Object.entries(ap.subcategorias).forEach(([sk, sub]) => {
        const sb = document.createElement("button");
        sb.textContent = sub.nombre;
        if (sk === subActual) sb.classList.add("activo");
        sb.onclick = (e) => {
          e.stopPropagation();
          subActual = sk;
          renderSelectores();
          resultado.textContent = "Pulsa generar…";
          metaEl.innerHTML = "";
          fijados = {};
        };
        subnavEl.appendChild(sb);
      });
    }
  });
}


/* =========================================================
   PROPUESTAS DE COMPOSICIÓN — 22 PANELES DE WALLY WOOD
   ========================================================= */
function elegirPaneles() {
  const copia = [...PANELES_WOOD];
  for (let i = copia.length - 1; i > 0; i--) {
    const j = Math.floor(Math.random() * (i + 1));
    [copia[i], copia[j]] = [copia[j], copia[i]];
  }
  propuestasPanel = copia.slice(0, 3);
  if (ideaActual && ideaActual.apartado === "dibujos") {
    ideaActual.panel = propuestasPanel[0];
    renderPaneles();
  }
}

function renderPaneles() {
  const bloque = document.getElementById("paneles-wood");
  const grid = document.getElementById("paneles-grid");
  const visible = !!ideaActual && ideaActual.apartado === "dibujos";
  bloque.hidden = !visible;
  if (!visible) return;

  grid.innerHTML = propuestasPanel.map(panel => {
    const seleccionado = ideaActual.panel && ideaActual.panel.id === panel.id;
    return `<button type="button" class="panel-wood ${seleccionado ? "seleccionado" : ""}" data-panel="${panel.id}" aria-pressed="${seleccionado}">
      <img src="${panel.image}" alt="Referencia visual: ${panel.name}" onerror="this.style.display='none';this.nextElementSibling.style.display='flex';">
      <span class="fallback">${panel.description}</span>
      <span class="panel-num">Panel ${String(panel.id).padStart(2,"0")}</span>
      <strong>${panel.name}</strong>
      <small>${panel.description}</small>
    </button>`;
  }).join("");

  grid.querySelectorAll("[data-panel]").forEach(btn => {
    btn.onclick = () => {
      const id = Number(btn.dataset.panel);
      ideaActual.panel = PANELES_WOOD.find(p => p.id === id);
      renderPaneles();
    };
  });
}

/* =========================================================
   GENERAR
   ========================================================= */
function generar(forzarCambioDe = null) {
  const conf = ejesActivos();
  const ejes = conf.ejes;

  const valores = {};
  Object.entries(ejes).forEach(([nombre, opciones]) => {
    valores[nombre] = fijados[nombre] ? fijados[nombre] : elegir(opciones);
  });

  const trans = {};
  Object.entries(TRANSVERSALES).forEach(([nombre, opciones]) => {
    trans[nombre] = fijados[nombre] ? fijados[nombre] : elegir(opciones);
  });

  if (forzarCambioDe) {
    const noFijados = Object.keys(ejes).filter(k => !fijados[k]);
    const noFijadosTrans = Object.keys(TRANSVERSALES).filter(k => !fijados[k]);
    const pool = [...noFijados, ...noFijadosTrans];
    if (pool.length) {
      const ejeACambiar = elegir(pool);
      if (ejes[ejeACambiar]) {
        let nuevo;
        do { nuevo = elegir(ejes[ejeACambiar]); } while (nuevo === valores[ejeACambiar] && ejes[ejeACambiar].length > 1);
        valores[ejeACambiar] = nuevo;
      } else if (TRANSVERSALES[ejeACambiar]) {
        let nuevo;
        do { nuevo = elegir(TRANSVERSALES[ejeACambiar]); } while (nuevo === trans[ejeACambiar] && TRANSVERSALES[ejeACambiar].length > 1);
        trans[ejeACambiar] = nuevo;
      }
    }
  }

  resultado.innerHTML = plantillaActiva()(valores);
  resultado.classList.remove("animate");
  void resultado.offsetWidth;
  resultado.classList.add("animate");

  metaEl.innerHTML = `
    <span>Público: ${trans.publico}</span>
    <span>Objetivo: ${trans.objetivo}</span>
    <span>Plataforma: ${trans.plataforma}</span>
  `;

  resultado.querySelectorAll("[data-eje]").forEach(el => {
    if (fijados[el.dataset.eje]) el.classList.add("fijado");
    el.onclick = () => toggleFijar(el.dataset.eje, el.textContent);
  });

  ideaActual = {
    texto: resultado.innerText,
    valores,
    trans,
    apartado: apartadoActual,
    sub: subActual,
    ejes: Object.keys(ejes)
  };

  if (apartadoActual === "dibujos") {
    elegirPaneles();
  } else {
    propuestasPanel = [];
    renderPaneles();
  }

  const li = document.createElement("li");
  li.innerHTML = resultado.innerHTML;
  historialUl.prepend(li);
  while (historialUl.children.length > 6) historialUl.lastChild.remove();
}

function toggleFijar(nombreEje, valor) {
  if (fijados[nombreEje] === valor) delete fijados[nombreEje];
  else fijados[nombreEje] = valor;
  resultado.querySelectorAll("[data-eje]").forEach(el => {
    if (fijados[el.dataset.eje]) el.classList.add("fijado");
    else el.classList.remove("fijado");
  });
}

/* =========================================================
   PROMPT PARA IA
   ========================================================= */
function construirPrompt(idea) {
  const estilo = PROMPT_STYLES[idea.apartado] || PROMPT_STYLES.dibujos;
  const prompt = estilo.construir(idea.valores);

  return `IMAGE GENERATION REQUEST

You must CREATE AND RENDER AN IMAGE based on the following instructions.

${prompt}

${idea.apartado === "dibujos" && idea.panel ? `PANEL COMPOSITION (WALLY WOOD TECHNIQUE):
${idea.panel.name}.
${idea.panel.description}
Use this composition as the camera framing and visual arrangement for the single comic panel. Adapt it to the scene and characters; do not copy the reference drawing itself.` : ""}

NEGATIVE PROMPT:
${estilo.negativo}

CREATIVE REFERENCE (Spanish):
${idea.texto}

The final output must be an actual generated image.
Do not respond with text, explanations, suggestions, or descriptions.`;
}

async function copiarPrompt(idea) {
  if (!idea) { alert("Genera una idea primero."); return false; }
  try {
    await navigator.clipboard.writeText(construirPrompt(idea));
    return true;
  } catch {
    alert("No se pudo copiar el prompt.");
    return false;
  }
}

/* =========================================================
   BANCO
   ========================================================= */
function cargarBanco() {
  try { banco = JSON.parse(localStorage.getItem("bancoIdeas") || "[]"); }
  catch { banco = []; }
}
function guardarBanco() {
  localStorage.setItem("bancoIdeas", JSON.stringify(banco));
  renderBanco();
  renderContador();
}
function renderContador() {
  document.getElementById("contador-banco").textContent =
    banco.length === 1 ? "1 idea guardada" : `${banco.length} ideas guardadas`;
}
function guardarIdeaActual() {
  if (!ideaActual) { alert("Genera una idea primero."); return; }
  if (banco.some(b => b.texto === ideaActual.texto)) {
    alert("Esa idea ya está en el banco.");
    return;
  }
  banco.unshift({ id: Date.now(), ...ideaActual, fecha: new Date().toISOString() });
  guardarBanco();
  const btn = document.getElementById("btn-guardar");
  const orig = btn.textContent;
  btn.textContent = "Guardada";
  setTimeout(() => btn.textContent = orig, 1200);
}

function renderBanco() {
  const cont = document.getElementById("lista-banco");
  const filtro = document.getElementById("filtro-plataforma").value;
  const items = filtro ? banco.filter(b => b.trans.plataforma === filtro) : banco;

  if (!items.length) {
    cont.innerHTML = `<div class="banco-vacio">No hay ideas${filtro ? " con ese filtro" : " guardadas todavía"}.</div>`;
    return;
  }

  cont.innerHTML = "";
  items.forEach(b => {
    const div = document.createElement("div");
    div.className = "banco-item";
    div.innerHTML = `
      <div class="texto">${b.texto}</div>
      <div class="tags">
        <span>${b.trans.plataforma}</span>
        <span>${b.trans.objetivo}</span>
        <span>${b.trans.publico}</span>
        <span>${b.apartado}${b.sub ? " · " + b.sub : ""}</span>
      </div>
      <div class="acciones-mini">
        <button data-copiar="${b.id}">Copiar</button>
        <button data-prompt="${b.id}">Prompt</button>
        <button data-reusar="${b.id}">Reusar</button>
        <button class="eliminar" data-eliminar="${b.id}">Eliminar</button>
      </div>
    `;
    cont.appendChild(div);
  });

  cont.querySelectorAll("[data-copiar]").forEach(btn => {
    btn.onclick = () => {
      const b = banco.find(x => x.id == btn.dataset.copiar);
      navigator.clipboard.writeText(b.texto);
      btn.textContent = "Copiado";
      setTimeout(() => btn.textContent = "Copiar", 1000);
    };
  });
  cont.querySelectorAll("[data-prompt]").forEach(btn => {
    btn.onclick = async () => {
      const b = banco.find(x => x.id == btn.dataset.prompt);
      const ok = await copiarPrompt(b);
      if (ok) { btn.textContent = "Copiado"; setTimeout(() => btn.textContent = "Prompt", 1000); }
    };
  });
  cont.querySelectorAll("[data-reusar]").forEach(btn => {
    btn.onclick = () => {
      const b = banco.find(x => x.id == btn.dataset.reusar);
      apartadoActual = b.apartado;
      subActual = b.sub;
      fijados = {};
      renderSelectores();
      mostrarPanel("generar");
      resultado.innerHTML = b.texto;
      metaEl.innerHTML = `
        <span>Público: ${b.trans.publico}</span>
        <span>Objetivo: ${b.trans.objetivo}</span>
        <span>Plataforma: ${b.trans.plataforma}</span>
      `;
      resultado.querySelectorAll("[data-eje]").forEach(el => {
        el.onclick = () => toggleFijar(el.dataset.eje, el.textContent);
      });
      ideaActual = { texto: b.texto, valores: b.valores, trans: b.trans, apartado: b.apartado, sub: b.sub, ejes: b.ejes, panel: b.panel || null };
      if (b.apartado === "dibujos") {
        propuestasPanel = b.panel ? [b.panel, ...PANELES_WOOD.filter(p => p.id !== b.panel.id).slice(0, 2)] : PANELES_WOOD.slice(0, 3);
      } else propuestasPanel = [];
      renderPaneles();
    };
  });
  cont.querySelectorAll("[data-eliminar]").forEach(btn => {
    btn.onclick = () => {
      banco = banco.filter(x => x.id != btn.dataset.eliminar);
      guardarBanco();
    };
  });
}

function initFiltro() {
  const sel = document.getElementById("filtro-plataforma");
  TRANSVERSALES.plataforma.forEach(p => {
    const o = document.createElement("option");
    o.value = p; o.textContent = p;
    sel.appendChild(o);
  });
  sel.onchange = renderBanco;
}

/* =========================================================
   EXPORTAR
   ========================================================= */
function exportarTxt() {
  if (!banco.length) { alert("El banco está vacío."); return; }
  const texto = banco.map(b =>
    `${b.texto}\n  Plataforma: ${b.trans.plataforma} | Objetivo: ${b.trans.objetivo} | Público: ${b.trans.publico}`
  ).join("\n\n");
  descargar("ideas.txt", texto, "text/plain");
}
function exportarJson() {
  if (!banco.length) { alert("El banco está vacío."); return; }
  descargar("ideas.json", JSON.stringify(banco, null, 2), "application/json");
}
function descargar(nombre, contenido, tipo) {
  const blob = new Blob([contenido], { type: tipo });
  const url = URL.createObjectURL(blob);
  const a = document.createElement("a");
  a.href = url; a.download = nombre; a.click();
  URL.revokeObjectURL(url);
}

/* =========================================================
   PANELES
   ========================================================= */
function mostrarPanel(key) {
  document.getElementById("panel-generar").hidden = key !== "generar";
  document.getElementById("panel-banco").hidden = key !== "banco";
  renderNav();
}

/* =========================================================
   INIT
   ========================================================= */
document.getElementById("btn-generar").onclick = () => generar();
document.getElementById("btn-otra-version").onclick = () => generar(true);
document.getElementById("btn-otras-composiciones").onclick = () => elegirPaneles();
document.getElementById("btn-guardar").onclick = guardarIdeaActual;
document.getElementById("btn-prompt").onclick = async () => {
  const btn = document.getElementById("btn-prompt");
  const orig = btn.textContent;
  const ok = await copiarPrompt(ideaActual);
  if (ok) { btn.textContent = "Prompt copiado"; setTimeout(() => btn.textContent = orig, 1400); }
};
document.getElementById("btn-exportar-txt").onclick = exportarTxt;
document.getElementById("btn-exportar-json").onclick = exportarJson;
document.getElementById("btn-vaciar").onclick = () => {
  if (confirm("¿Vaciar todo el banco?")) { banco = []; guardarBanco(); }
};

cargarBanco();
initFiltro();
renderContador();
renderBanco();
renderNav();
renderSelectores();
</script>
