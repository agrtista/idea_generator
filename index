        },
        plantilla: (v) => `Noticia de <span class="hl" data-eje="tema">${v.tema}</span> contada como <span class="hl2" data-eje="angulo">${v.angulo}</span> en <span class="hl" data-eje="formato">${v.formato}</span>.`
      },
      humor: {
        nombre: "Humor",
